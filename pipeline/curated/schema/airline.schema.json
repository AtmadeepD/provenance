{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AirlineCuratedSchema",
  "type": "object",
  "properties": {
    "operator_id": { "type": "string" },
    "name": { "type": "string" },
    "country": { "type": "string" },
    "founded": { "type": ["integer", "string"] },
    "ceased": { "type": ["string", "null"] },
    "livery": {
      "type": "object",
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" }
      },
      "required": ["primary", "secondary"]
    },
    "snapshot_fleet_size": {
      "type": "object",
      "properties": {
        "count": { "type": "string" },
        "as_of": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["count", "as_of"]
    },
    "obituary_md": { "type": "string" },
    "airframes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "airframe_id": { "type": "string" },
          "manufacturer": { "type": "string" },
          "type": { "type": "string" },
          "msn": { "type": "string" },
          "first_flight": { "type": ["string", "null"] },
          "status": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": ["active", "stored", "withdrawn", "scrapped", "written_off", "preserved", "unknown"]
              },
              "place": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" }
                }
              },
              "as_of": { "type": "string" },
              "last_physical_sighting": { "type": "string" },
              "note": { "type": "string" }
            },
            "required": ["state", "as_of"]
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["delivery", "transfer", "repossession", "returned_to_lessor", "sold", "conversion", "accident", "storage", "return_to_service", "scrapped", "preserved"]
                },
                "place": { "type": "string" },
                "party": { "type": "string" },
                "flight": { "type": "string" },
                "outcome": { "type": "string" },
                "note": { "type": "string" }
              },
              "required": ["date", "type"]
            }
          },
          "identities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reg": { "type": "string" },
                "country": { "type": "string" },
                "from": { "type": ["string", "null"] },
                "to": { "type": ["string", "null"] }
              },
              "required": ["reg"]
            }
          },
          "eras": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operator_id": { "type": "string" },
                "role": { "type": "string" },
                "from": { "type": ["string", "null"] },
                "to": { "type": ["string", "null"] }
              },
              "required": ["operator_id", "role"]
            }
          },
          "conversions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "enum": ["freighter", "vip", "tanker", "test"] },
                "date": { "type": "string" }
              },
              "required": ["kind"]
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": { "type": "string" },
                "note": { "type": "string" }
              },
              "required": ["ref"]
            }
          },
          "confidence": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string",
                "enum": ["verified", "partial", "sketchy"]
              },
              "status": {
                "type": "string",
                "enum": ["verified", "partial", "sketchy"]
              }
            },
            "required": ["identity", "status"]
          }
        },
        "required": [
          "airframe_id", "manufacturer", "type", "msn", "status", "events", "identities", "eras", "sources", "confidence"
        ]
      }
    }
  },
  "required": ["operator_id", "name", "country", "founded", "livery", "obituary_md", "airframes"]
}
